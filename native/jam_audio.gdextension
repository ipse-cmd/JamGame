[configuration]

entry_symbol = "jam_audio_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://native/bin/jam_audio.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://native/bin/jam_audio.windows.template_debug.x86_64.dll"
linux.debug.x86_64 = "res://native/bin/libjam_audio.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://native/bin/libjam_audio.linux.template_debug.x86_64.so"
macos.debug = "res://native/bin/libjam_audio.macos.template_debug.universal.dylib"
macos.release = "res://native/bin/libjam_audio.macos.template_debug.universal.dylib"
